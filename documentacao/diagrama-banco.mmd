erDiagram
    AUTH_USERS ||--o| CLIENTES : "login do cliente"
    CLIENTES ||--o{ VEICULOS : possui
    CLIENTES ||--o{ ORDENS : solicita
    VEICULOS ||--o{ ORDENS : "é atendido em"
    CLIENTES ||--o{ AGENDAMENTOS : agenda
    VEICULOS ||--o{ AGENDAMENTOS : "é levado em"
    SERVICOS ||--o{ AGENDAMENTOS : "é escolhido em"
    ORDENS ||--o{ PAGAMENTOS : recebe
    ORDENS ||--o| AVALIACOES : "é avaliada em"
    CLIENTES ||--o{ AVALIACOES : escreve
    CLIENTES ||--o| CONVERSAS : "tem um chat"
    CONVERSAS ||--o{ MENSAGENS_CHAT : contem
    CLIENTES ||--o{ MENSAGENS_CHAT : envia

    AUTH_USERS {
        uuid id PK
        text email
    }
    CLIENTES {
        text id PK
        uuid auth_id FK
        text nome
        text telefone
        text email
    }
    VEICULOS {
        text id PK
        text cliente_id FK
        text placa
        text marca
        text modelo
        text ano
        text cor
    }
    ORDENS {
        text id PK
        text numero
        text cliente_id FK
        text veiculo_id FK
        text status
        text mecanico
        jsonb itens
    }
    AGENDAMENTOS {
        text id PK
        text cliente_id FK
        text veiculo_id FK
        text servico_id FK
        text data
        text hora
        text status
    }
    SERVICOS {
        text id PK
        text nome
        text categoria
        numeric preco
    }
    ESTOQUE {
        text id PK
        text nome
        int quantidade
        numeric preco
        text imagem
    }
    PAGAMENTOS {
        text id PK
        text ordem_id FK
        numeric valor
        text forma
    }
    AVALIACOES {
        text id PK
        text ordem_id FK
        text cliente_id FK
        int nota
    }
    CONVERSAS {
        text id PK
        text cliente_id FK
    }
    MENSAGENS_CHAT {
        text id PK
        text conversa_id FK
        text cliente_id FK
        text autor
        text texto
        boolean lida
    }
    MENSAGENS {
        text id PK
        text nome
        text email
        text assunto
        boolean lida
    }
