# URL de conexão com o PostgreSQL
# Local: postgres://usuario:senha@localhost:5432/torque
# Nuvem (Render, Railway, etc.): copie a connection string fornecida pelo provedor
DATABASE_URL=postgres://postgres:torque123@localhost:5432/torque

# Credenciais do administrador (troque antes de publicar o site)
ADMIN_EMAIL=admin@torque.com.br
ADMIN_SENHA=admin1234

# Porta da API (Express)
PORT=3001

# URL da API usada pelo front-end
# Em desenvolvimento local, pode deixar assim
VITE_API_URL=http://localhost:3001/api
